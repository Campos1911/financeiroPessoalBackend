generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String       @id @unique @default(uuid())
  email      String       @unique
  senha      String
  Lancamento Lancamento[]
}

model Lancamento {
  id        String             @id @unique @default(uuid())
  descricao String
  valor     Int
  tipo      TipoLancamentoEnum
  data      String
  user      User               @relation(fields: [userId], references: [id])
  userId    String
}

enum TipoLancamentoEnum {
  entrada
  saida
}
